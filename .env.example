# Public URL of the deployed site (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.example.co.uk

# Enquiry delivery (optional). When set, contact form submissions are emailed via Resend.
# Without these, submissions are logged in development and rejected in production
# (the form then shows the email/phone fallback so no lead is silently lost).
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=Tjdurrani1@gmail.com
